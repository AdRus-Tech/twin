# Docker only. Replace both example values locally before starting.
# Use a password consisting of letters and digits (it is part of DATABASE_URL).
POSTGRES_PASSWORD=replace-with-a-random-local-password
DJANGO_SECRET_KEY=replace-with-a-random-local-secret

AI_PROVIDER=demo
AI_ALLOW_EXTERNAL=0
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_S=30
AI_JSON_MODE=1
AI_TEMPERATURE=
